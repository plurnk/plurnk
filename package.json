{
    "name": "@plurnk/plurnk",
    "version": "0.80.0",
    "description": "Plurnk terminal client — one-shot CLI and scrollback-native interactive AG-UI client.",
    "type": "module",
    "license": "MIT",
    "publishConfig": {
        "access": "public"
    },
    "engines": {
        "node": ">=26"
    },
    "bin": {
        "plurnk": "bin/plurnk.js"
    },
    "files": [
        "bin/plurnk.js",
        "dist/**/*",
        "conformance/agui-client.json",
        ".env.defaults",
        "README.md",
        "man/",
        "completions/"
    ],
    "scripts": {
        "test:lint": "tsc --noEmit",
        "test:unit": "node --test 'src/**/*.test.ts'",
        "pretest:intg": "npm run build",
        "test:intg": "node --test --env-file-if-exists=.env 'test/intg/**/*.test.ts'",
        "test": "npm run test:lint && npm run test:unit && npm run test:intg && npm run test:tui",
        "test:all": "npm test",
        "deps:fresh": "npm outdated",
        "build:clean": "node scripts/clean-dist.mjs",
        "build:dist": "tsc -p tsconfig.build.json",
        "build:info": "node scripts/write-build-info.mjs",
        "build": "npm run build:clean && npm run build:dist && npm run build:info",
        "prepare": "git config core.hooksPath .githooks && npm run build",
        "prepublishOnly": "npm run test && npm audit --audit-level=high && npm run deps:fresh && npm run test:composition",
        "pretest:tui": "npm run build",
        "test:tui": "node --test --test-timeout=600000 --env-file-if-exists=.env 'test/tui/**/*.test.ts'",
        "test:tui:live": "PLURNK_CLIENT_LIVE=1 node --test --test-timeout=600000 --env-file-if-exists=.env test/tui/live.test.ts",
        "build:global:install": "npm run build && npm install -g .",
        "build:global:uninstall": "npm uninstall -g @plurnk/plurnk",
        "build:local:install": "node scripts/install-sandbox.mjs install",
        "build:local:uninstall": "node scripts/install-sandbox.mjs uninstall",
        "test:installation": "node scripts/test-installation.mjs",
        "test:composition": "node scripts/test-composition.mjs",
        "release:publish": "node scripts/release-publish.mjs",
        "build:posix": "node scripts/generate-posix.mjs"
    },
    "devDependencies": {
        "@types/node": "^26.1.1",
        "@types/ws": "^8.18.1",
        "node-pty": "^1.1.0",
        "typescript": "^7.0.2"
    },
    "dependencies": {
        "@ag-ui/client": "^0.0.59",
        "@ag-ui/core": "^0.0.59",
        "@earendil-works/pi-tui": "^0.84.3",
        "@plurnk/plurnk-contracts": "^1.13.0",
        "beautiful-mermaid": "^1.1.3",
        "cli-table3": "^0.6.5",
        "marked": "^18.0.11",
        "string-width": "^8.2.2",
        "wrap-ansi": "^10.0.1"
    },
    "plurnk": {
        "builtAgainst": "1.13.0"
    },
    "man": "./man/plurnk.1"
}
