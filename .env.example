# plurnk client app environment.
# Override order: shell > .env > .env.example (this file).
#
# The client is a thin daemon-RPC client. All engine config (DB path, max
# turns, provider config) lives in plurnk-service's environment; this client
# only needs to know how to connect.

# --- Daemon connection ---
PLURNK_URL=ws://127.0.0.1:3044
