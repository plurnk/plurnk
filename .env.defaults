# @plurnk/plurnk — the CLI/TUI client. Owned prefix: PLURNK_CLIENT_* (ecosystem
# standard: every package ships its knobs; this file IS the documentation).
# The client loads this itself, set-if-unset, beneath project/user env files and
# shell exports. Every flag is a knob's spelling for one invocation:
# PLURNK_CLIENT_MAX_TURNS is --max-turns. The daemon owns its model and provider
# keys; inspect their complete owner-labelled catalog with `plurnk-service config defaults`.

# --- Which conversation ---
# Resume a workspace by name, or create it (rooted at cwd) if none exists.
# Unset = a fresh auto-named workspace per invocation ("cli" one-shot / "tui" REPL).
# PLURNK_CLIENT_WORKSPACE=

# Resume (or create) a named worker — the CONVERSATION — within that workspace.
# Requires PLURNK_CLIENT_WORKSPACE. Unset = the workspace's default conversation.
# PLURNK_CLIENT_WORKER=

# Persist this model selector on the conversation's worker before its first loop: a declared
# alias or an exact provider/model route. Unset = the worker's own model, else the daemon's.
# PLURNK_CLIENT_MODEL=

# Persist this reasoning policy on the conversation's worker before its first loop.
# Unset = the worker's own, else the daemon's.
# PLURNK_CLIENT_REASONING=

# --- A workspace this client creates ---
# Absolute path passed as the workspace's project root at creation (the workspace
# for file ops). Unset = the editor/shell cwd. Empty string = explicitly headless.
# The root is decided at creation, permanently — changing it is unimplemented by design.
# PLURNK_CLIENT_PROJECT_ROOT=

# CapabilityPolicy JSON applied when this client creates a workspace. Existing
# workspaces retain their durable setting.
# PLURNK_CLIENT_CAPABILITIES={}

# Turn-0 tracked-file preview for the workspace: -1 full, 0 off, N first-N. Unset = the daemon's.
# PLURNK_CLIENT_FILES_ITEMS=

# Ceiling on operations per emission for the workspace; it can only tighten the daemon's.
# PLURNK_CLIENT_MAX_COMMANDS=

# 1 = deny git membership and working-tree status for the workspace.
# PLURNK_CLIENT_NO_GIT=

# --- Every loop this client starts ---
# 1 = auto-accept every proposal locally without prompting; 0 = review each one.
# A prompt that starts with `?` is reviewed regardless. Shipping 0: the service asks for review, and
# a client that answers for you without showing you the question makes that setting a fiction. Toggle
# it for the session with Shift-Tab (or `/yolo`, or Alt-Y); the header says `yolo: off` when it is.
PLURNK_CLIENT_YOLO=0

# 1 = nobody is attending: every loop is stated unattended, so the daemon offers no
# human-in-the-loop surface and settles proposals as its own panel says. 0 = say nothing.
PLURNK_CLIENT_AUTO=0

# What every loop does with a proposal: review | accept | reject. Unset = say nothing;
# the daemon's panel decides. A `?` prompt states review for that loop.
# PLURNK_CLIENT_PROPOSALS=

# Model-call budget for each prompt's worker tree: the loop's turns, its descendants' turns and
# every BARE call, one per call. Unset = the daemon's.
# PLURNK_CLIENT_MAX_TURNS=

# Cancel each prompt's loop after this many seconds. Unset = never.
# PLURNK_CLIENT_TIMEOUT=

# --- What the waterfall shows ---
# Lines of every operation body and concluded execution output shown beneath its row, independent
# of the terminal's height; the rest is named with the address LOOK reads it at. A NOTE's body and
# the delivered answer are whole. --preview-lines spells it for one invocation.
PLURNK_CLIENT_PREVIEW_LINES=3

# --- What a one-shot run prints ---
# Truthy = one-shot runs emit the complete json record document on stdout (--json).
# PLURNK_CLIENT_JSON=

# Truthy = also print one greppable accounting row per turn on stderr.
# PLURNK_CLIENT_STATUS_STREAM=

# When a one-shot prompt or an interactive session ends, write the workspace's share for a bug
# report into this folder and <folder>.zip beside it: what the models saw and wrote, unredacted.
# A leading ~/ expands. An existing share there is refused, never overwritten. Unset = none.
# PLURNK_CLIENT_SHARE=
