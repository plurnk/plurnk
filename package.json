{
    "name": "@plurnk/plurnk",
    "version": "5.0.2",
    "description": "Plurnk terminal client — one-shot CLI and scrollback-native interactive ACP client.",
    "type": "module",
    "license": "MIT",
    "publishConfig": {
        "access": "public"
    },
    "engines": {
        "node": ">=26"
    },
    "bin": {
        "plurnk": "bin/plurnk.js"
    },
    "files": [
        "bin/plurnk.js",
        "dist/**/*",
        "conformance/acp-client.json",
        ".env.defaults",
        "README.md"
    ],
    "scripts": {
        "deps:check": "node scripts/deps-check.mjs",
        "deps:drift": "node scripts/deps-drift.mjs",
        "test:lint": "tsc --noEmit && node scripts/deps-check.mjs && node ../plurnk-service/plurnk-spec-check/check.mjs . && npm run test:posix",
        "pretest:posix": "npm run build:posix",
        "test:posix": "node scripts/check-posix.mjs",
        "pretest:unit": "npm run build:posix",
        "test:unit": "node --env-file-if-exists=.env.defaults --test --test-timeout=30000 'src/**/*.test.ts' 'scripts/**/*.test.mjs'",
        "pretest:intg": "npm run build",
        "test:intg": "node --test --test-concurrency=$(node scripts/test-concurrency.mjs) --test-timeout=120000 --env-file-if-exists=.env 'test/intg/**/*.test.ts'",
        "test": "npm run test:lint && npm run test:unit && npm run test:intg && npm run test:tui",
        "test:all": "npm test",
        "build:clean": "node scripts/clean-dist.mjs",
        "build:dist": "tsc -p tsconfig.build.json",
        "build:info": "node scripts/write-build-info.mjs",
        "build": "npm run build:clean && npm run build:dist && npm run build:info && npm run build:posix",
        "prepare": "git config core.hooksPath .githooks && npm run build",
        "prepublishOnly": "npm run test && node scripts/audit-gate.mjs && npm run test:composition",
        "pretest:tui": "npm run build",
        "test:tui": "node --test --test-concurrency=$(node scripts/test-concurrency.mjs) --test-timeout=600000 --env-file-if-exists=.env 'test/tui/**/*.test.ts'",
        "test:tui:live": "PLURNK_CLIENT_LIVE=1 node --test --test-timeout=600000 --env-file-if-exists=.env test/tui/live.test.ts",
        "build:global:install": "npm run build && npm install -g --ignore-scripts .",
        "build:global:uninstall": "npm uninstall -g @plurnk/plurnk",
        "build:local:install": "node scripts/install-sandbox.mjs install",
        "build:local:uninstall": "node scripts/install-sandbox.mjs uninstall",
        "test:installation": "node scripts/test-installation.mjs",
        "test:composition": "node scripts/test-composition.mjs",
        "release:gate": "node scripts/deps-drift.mjs && node scripts/audit-gate.mjs",
        "build:posix": "node scripts/generate-posix.mjs"
    },
    "devDependencies": {
        "@types/node": "^26.6.6",
        "@xterm/headless": "^6.0.0",
        "node-pty": "^1.1.0",
        "typescript": "^7.0.2"
    },
    "allowScripts": {
        "@google/genai@2.21.0": false,
        "node-pty@1.1.0": true,
        "protobufjs@7.6.6": false
    },
    "dependencies": {
        "@agentclientprotocol/sdk": "^2.2.0",
        "@earendil-works/pi-tui": "1.4.0",
        "@plurnk/plurnk-contracts": "^7.0.2",
        "beautiful-mermaid": "^1.1.3",
        "open": "^11.0.4",
        "string-width": "^8.3.0"
    },
    "optionalDependencies": {
        "@plurnk/plurnk-service": "^5.0.2"
    },
    "man": "./dist/posix/man/plurnk.1"
}
