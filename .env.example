# plurnk client app environment.
# Override order: shell > .env > .env.example (this file).

# --- Storage ---
PLURNK_DB_PATH=./plurnk_dev.db

# --- Loop control ---
# Safety cap on turns per loop. Engine.runLoop force-terminates with 499
# (Client Closed Request) if a loop emits SEND[102] continuously past
# this number without reaching a terminal SEND[200] or SEND[499].
PLURNK_MAX_TURNS=50

# --- Provider (OpenAI-compatible) ---
OPENAI_BASE_URL=http://localhost:11435
OPENAI_API_KEY=
OPENAI_MODEL=macher.gguf
OPENAI_CONTEXT_SIZE=262144
OPENAI_FETCH_TIMEOUT_MS=600000
OPENAI_THINK=0
